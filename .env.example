# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings (Project Settings -> Database -> Connection string)
# Use the direct/session connection string, not the pgbouncer transaction-mode
# one — Prisma migrations need a direct connection.
DATABASE_URL=

# Anthropic (Phase 2A.2 — AI Marketing Strategy). Server-side only, read
# exclusively in src/server/ai/anthropic-client.ts. Never expose to the
# client / NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# Optional override — defaults to a pinned model id in anthropic-client.ts.
ANTHROPIC_MODEL=
