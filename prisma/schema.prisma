// Phase 1 schema only. See docs/architecture.md for the tables deferred to
// Phases 2-4 (creatives, leads, whatsapp_messages, outcomes, funnel_events) —
// they attach to `Campaign.id` later without touching these models.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 removed schema-level
// datasource.url) and in the PrismaPg adapter in src/server/db/client.ts.
datasource db {
  provider = "postgresql"
}

// Reserves the full campaign lifecycle even though Phase 1 only implements
// draft -> confirmed. Later values are unused by Phase 1 code.
enum CampaignStatus {
  draft
  confirmed
  content_ready
  live
  active
  closed
}

// Every mutating action in the system is stamped with who/what did it, so
// human/AI/system responsibility is queryable rather than just conventional.
enum ActorType {
  human
  ai
  system
}

// draft: freshly (re)generated, awaiting human review.
// approved: the live/active version for this campaign (human review phase).
// archived: superseded — either replaced by a newer draft, or by a newer
// approved version. Terminal; never re-activated.
enum MarketingStrategyStatus {
  draft
  approved
  archived
}

// Same lifecycle shape as MarketingStrategyStatus, kept as its own enum
// rather than shared — ContentSet and MarketingStrategy are independently
// versioned entities with their own lifecycles.
enum ContentSetStatus {
  draft
  approved
  archived
}

// facebook/instagram both route through the Meta provider slot; tiktok its
// own — see src/server/providers/ads/provider-registry.ts. WhatsApp is
// deliberately excluded — it is never a publishing target here.
enum LaunchPlatform {
  facebook
  instagram
  tiktok
}

// Phase 3B assigns only "new" — every Lead starts here. hot/warm/cold are
// reserved for the (not-yet-built) AI classification phase; no code in this
// phase ever writes those values.
enum LeadStatus {
  new
  hot
  warm
  cold
}

// Phase 3B never advances this past its default — no application workflow
// exists yet. Reserved for a later phase.
enum ApplicationStatus {
  not_started
  in_progress
  submitted
}

enum WhatsAppMessageDirection {
  inbound
  outbound
}

// No in-flight state (e.g. "sending") by design — see FollowUp.claimedAt
// for how follow-up-service.ts achieves concurrency-safe processing
// without one. A row only ever becomes "sent" after the WhatsApp provider
// call actually succeeds.
enum FollowUpStatus {
  pending
  sent
  failed
  cancelled
}

// No "open"/"pending" value by design — a Sale row's mere existence is the
// resolution event (Phase 4A trigger is "Application resolved"). Only ever
// written by sale-service.ts, never by AI/system code.
enum SaleStatus {
  won
  lost
}

// Independent from ContentSetStatus — this describes publishing state, not
// content review state. "approved" (ContentSet) is not the same concept as
// "live" (Launch).
enum LaunchStatus {
  pending
  launching
  live
  failed
  cancelled
}

// One uploaded file = one independent dataset. Datasets are never merged,
// cleaned, matched, or deduplicated against each other.
model Dataset {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  sourceFilename String   @map("source_filename")
  importedById   String?  @map("imported_by_id") @db.Uuid // references auth.users, no FK (separate schema)
  importedAt     DateTime @default(now()) @map("imported_at")
  rowCount       Int      @map("row_count")

  buildings         Building[]
  campaignDatasets  CampaignDataset[]
  campaignBuildings CampaignBuilding[]
  acquisitionEvents AcquisitionEvent[]

  @@map("datasets")
}

// Always scoped to exactly one dataset. Never deduplicated against another
// dataset's buildings.
model Building {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasetId      String  @map("dataset_id") @db.Uuid
  name           String
  address        String?
  lat            Float?
  lng            Float?
  unitCount      Int?    @map("unit_count")
  // Unmapped source columns from the import file, kept as-is rather than
  // forcing a rigid import schema.
  rawAttributes  Json    @default("{}") @map("raw_attributes")
  createdAt      DateTime @default(now()) @map("created_at")

  dataset           Dataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  campaignBuildings CampaignBuilding[]

  @@index([datasetId])
  @@map("buildings")
}

model Campaign {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  productPromotion String         @map("product_promotion")
  // { amount, currency, terms } — official facts only. Never merged with
  // differentiators; Phase 2's AI prompt-building relies on this separation.
  officialPricing  Json           @map("official_pricing")
  // CLZ-specific marketing angles, kept structurally separate from
  // officialPricing.
  differentiators  Json           @default("[]")
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime       @map("end_date") @db.Date
  status           CampaignStatus @default(draft)
  createdById      String?        @map("created_by_id") @db.Uuid // references auth.users
  confirmedById    String?        @map("confirmed_by_id") @db.Uuid // references auth.users
  confirmedAt      DateTime?      @map("confirmed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  campaignDatasets  CampaignDataset[]
  campaignBuildings CampaignBuilding[]
  marketingStrategies MarketingStrategy[]
  contentSets ContentSet[]
  launches Launch[]
  acquisitionEvents AcquisitionEvent[]
  leads Lead[]
  sales Sale[]

  @@map("campaigns")
}

// Phase 2A.2: AI-generated marketing strategy for a confirmed campaign.
// Versioned rather than overwritten — regenerating creates a new row, never
// mutates a prior one. See campaign-service.ts / marketing-strategy-service.ts
// for the exact lifecycle rules.
model MarketingStrategy {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId    String                  @map("campaign_id") @db.Uuid
  version       Int
  status        MarketingStrategyStatus @default(draft)

  // Validated AI output (see server/ai/schemas/marketing-strategy-output.ts).
  content       Json
  // Exact MarketingStrategyInput snapshot used to generate this version —
  // auditability, independent of any later change to how the brief/analysis
  // is computed.
  inputSnapshot Json                    @map("input_snapshot")

  generatedById String?   @map("generated_by_id") @db.Uuid // references auth.users
  approvedById  String?   @map("approved_by_id") @db.Uuid  // references auth.users; unused until the human-review phase
  approvedAt    DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentSets ContentSet[]

  @@unique([campaignId, version])
  @@index([campaignId])
  @@map("marketing_strategies")
}

// Phase 2B: AI-generated platform-specific content (Facebook, Instagram,
// TikTok, WhatsApp) for a campaign, derived from its approved
// MarketingStrategy. Same versioned draft/approved/archived shape as
// MarketingStrategy — editing/approval behavior belongs to Phase 2C, not
// implemented here; approvedById/approvedAt exist now purely so that phase
// needs no further migration.
model ContentSet {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId          String           @map("campaign_id") @db.Uuid
  marketingStrategyId String           @map("marketing_strategy_id") @db.Uuid
  version             Int
  status              ContentSetStatus @default(draft)

  // Validated AI output (see server/ai/schemas/content-set-output.ts):
  // { facebook: Variant[], instagram: Variant[], tiktok: Variant[], whatsapp: Variant[] }
  content       Json
  // Exact ContentGenerationInput snapshot used to generate this version —
  // auditability, independent of any later change to the strategy/brief.
  inputSnapshot Json             @map("input_snapshot")

  generatedById String?   @map("generated_by_id") @db.Uuid // references auth.users
  approvedById  String?   @map("approved_by_id") @db.Uuid  // references auth.users; unused until Phase 2C
  approvedAt    DateTime? @map("approved_at")               // unused until Phase 2C

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  marketingStrategy MarketingStrategy @relation(fields: [marketingStrategyId], references: [id], onDelete: Restrict)
  launches          Launch[]

  @@unique([campaignId, version])
  @@index([campaignId])
  @@index([marketingStrategyId])
  @@map("content_sets")
}

// Phase 2D: a single platform publishing attempt for one human-selected
// ContentVariant from an approved ContentSet. One row per platform per
// logical attempt — Facebook and Instagram are always separate rows even
// though both route through the same Meta provider slot. Never mutates
// Campaign/ContentSet/MarketingStrategy; those stay immutable inputs.
//
// idempotencyKey is deterministic (campaignId + contentSetId + platform +
// variantIndex) — the "logical launch target". It is NOT unique across all
// rows: a failed/cancelled attempt is preserved forever, and an explicit
// human retry creates a brand new row with the same key. Uniqueness of
// "at most one active attempt per logical target" is an application-level
// invariant enforced in launch-service.ts (matching how "at most one
// approved MarketingStrategy/ContentSet per campaign" is enforced there
// too), not a DB constraint.
//
// selectedVariant is a full snapshot of the chosen ContentVariant at launch
// time — this record must stay interpretable even if ContentSet's schema
// changes later, same reasoning as inputSnapshot elsewhere.
model Launch {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId         String         @map("campaign_id") @db.Uuid
  contentSetId       String         @map("content_set_id") @db.Uuid
  contentSetVersion  Int            @map("content_set_version")
  platform           LaunchPlatform
  variantIndex       Int            @map("variant_index")
  selectedVariant    Json           @map("selected_variant")
  status             LaunchStatus   @default(pending)

  // Which adapter actually handled this — "stub" during Phase 2D, "meta" /
  // "tiktok" once real adapters exist. Never treat externalCampaignId/
  // externalAdId/externalCreativeId as our identity — they are opaque,
  // provider-owned values, recorded only once a provider returns them.
  provider           String?
  externalCampaignId String? @map("external_campaign_id")
  externalAdId       String? @map("external_ad_id")
  externalCreativeId String? @map("external_creative_id")
  failureReason      String? @map("failure_reason")

  idempotencyKey String  @map("idempotency_key")
  createdById    String? @map("created_by_id") @db.Uuid // references auth.users

  launchedAt DateTime? @map("launched_at") // set only on transition to live
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentSet ContentSet @relation(fields: [contentSetId], references: [id], onDelete: Restrict)
  acquisitionEvents AcquisitionEvent[]

  @@index([campaignId])
  @@index([contentSetId])
  @@index([idempotencyKey])
  @@map("launches")
}

// Phase 3A: records where an incoming customer click originated from
// (source/medium/campaign/ref — standard UTM-style attribution), kept
// exactly as received. campaignId is the sole authoritative campaign
// attribution — these string fields are never merged, inferred from, or
// used to override it. Purely an attribution log; never creates or
// modifies a Campaign, Lead, or WhatsApp record.
//
// The relation field is named `campaignRecord`, not `campaign` — every
// other model in this schema names its Campaign relation `campaign`, but
// that name is already taken here by the UTM `campaign` attribution field
// below, so the relation is renamed on this one model to avoid the clash.
//
// Stage 10 (Phase 4 final): datasetId/launchId are the smallest additive
// relationship needed to trace a click back to a specific Dataset and/or
// creative (Launch = contentSetId+contentSetVersion+platform+variantIndex,
// already a stable identity — see Launch's own doc comment; no separate
// "Creative" table was introduced). Both nullable: a click's tracking URL
// may not always carry this detail (e.g. a campaign spanning multiple
// datasets via one shared link), and neither field is ever inferred or
// guessed — see acquisition-service.ts, which validates that a supplied
// datasetId/launchId genuinely belongs to the same campaign before
// persisting it.
model AcquisitionEvent {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  datasetId  String? @map("dataset_id") @db.Uuid
  launchId   String? @map("launch_id") @db.Uuid

  source   String? // e.g. utm_source
  medium   String? // e.g. utm_medium
  campaign String? // e.g. utm_campaign — distinct from the Campaign relation below
  ref      String? // free-form reference / click id

  createdAt DateTime @default(now()) @map("created_at")

  campaignRecord Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dataset        Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  launch         Launch?  @relation(fields: [launchId], references: [id], onDelete: SetNull)
  leads          Lead[]

  @@index([campaignId])
  @@index([createdAt])
  @@index([datasetId])
  @@index([launchId])
  @@map("acquisition_events")
}

// Phase 3B: data foundation only. A Lead is campaign-scoped — the same
// phone number contacting two different campaigns produces two separate
// Lead rows; leads are never merged globally across campaigns. Reused via
// (campaignId, phone) — see lead-service.ts. status starts at "new" and
// stays there in this phase; no AI classification exists yet.
// applicationStatus/agentId/handoverAt are reserved for later phases
// (application workflow / human handover) — this phase never writes to
// them beyond their defaults.
model Lead {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId         String             @map("campaign_id") @db.Uuid
  acquisitionEventId String?            @map("acquisition_event_id") @db.Uuid
  phone              String
  name               String?
  customerInfo       Json               @default("{}") @map("customer_info")
  status             LeadStatus         @default(new)
  handoverAt         DateTime?          @map("handover_at")
  agentId            String?            @map("agent_id") @db.Uuid // references auth.users; unused until human handover phase
  applicationStatus  ApplicationStatus  @default(not_started) @map("application_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  acquisitionEvent AcquisitionEvent? @relation(fields: [acquisitionEventId], references: [id], onDelete: SetNull)
  statusHistory    LeadStatusHistory[]
  threads          WhatsAppThread[]
  messages         WhatsAppMessage[]
  followUps        FollowUp[]
  sale             Sale?

  @@index([campaignId])
  @@index([phone])
  @@index([campaignId, phone])
  @@map("leads")
}

// Append-only. Phase 3B writes exactly one row per Lead (the initial
// fromStatus=null -> toStatus=new transition, actorType=system) — no
// classification logic runs in this phase, so no further rows are written
// here yet.
model LeadStatusHistory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String      @map("lead_id") @db.Uuid
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  reason     String?
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

// One active thread per Lead in Phase 3B — no multi-thread conversation
// management yet. (provider, externalThreadId) identifies the thread on
// the provider's side; provider is a free-text tag ("stub" in this phase)
// mirroring Launch.provider, not an enum, so a real adapter needs no
// migration to register itself.
model WhatsAppThread {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String   @map("lead_id") @db.Uuid
  provider         String
  externalThreadId String   @map("external_thread_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@index([leadId])
  @@index([provider, externalThreadId])
  @@map("whatsapp_threads")
}

// externalMessageId is provider-owned and never treated as our identity —
// same reasoning as Launch.externalCampaignId/externalAdId. It is used
// only for idempotency (see whatsapp-service.ts): when present, a retried
// webhook delivery with the same externalMessageId must not create a
// second row. leadId is denormalized alongside threadId (thread already
// implies lead) purely to make lead-scoped message queries cheap without a
// join — same shape as CampaignBuilding keeping datasetId explicit.
model WhatsAppMessage {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId           String                    @map("thread_id") @db.Uuid
  leadId             String                    @map("lead_id") @db.Uuid
  direction          WhatsAppMessageDirection
  content            String
  externalMessageId  String?                   @map("external_message_id")
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now()) @map("created_at")

  thread WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lead   Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([leadId, createdAt])
  @@index([externalMessageId])
  @@map("whatsapp_messages")
}

// Phase 3E: Day 1/3/7 follow-up messages for a Lead on the warm/cold
// journey. `day` is a plain Int (1|3|7); the allowed set is enforced in
// follow-up-service.ts, not the database — matching this project's
// existing convention of enforcing invariants at the application/service
// level (e.g. Launch's idempotencyKey) rather than in the schema.
//
// `claimedAt` exists solely for concurrency-safe processing WITHOUT an
// in-flight status value: processDueFollowUps() atomically claims a row
// via `UPDATE ... WHERE status = 'pending' AND claimed_at IS NULL`
// (Postgres guarantees only one concurrent caller can win that per-row
// update), then only that caller attempts the WhatsApp send and decides
// the real outcome (sent/failed). `status` therefore only ever reflects a
// row's actual, final outcome — it is never set to "sent" before the
// provider call has actually succeeded. If the process crashes between
// claiming and recording an outcome, the row is left claimed-but-pending
// forever; recovering such rows is out of scope for Phase 3E, the same
// crash-window caveat already accepted in launch-service.ts.
model FollowUp {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId        String         @map("lead_id") @db.Uuid
  day           Int
  scheduledAt   DateTime       @map("scheduled_at")
  status        FollowUpStatus @default(pending)
  claimedAt     DateTime?      @map("claimed_at")
  sentAt        DateTime?      @map("sent_at")
  failureReason String?        @map("failure_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
  @@index([leadId, day])
  @@map("follow_ups")
}

// Phase 4A: the final sales outcome for a Lead, recorded by a human agent
// once the Lead's application has been submitted. At most one Sale per
// Lead (leadId is unique) — a correction (e.g. won -> lost) updates this
// same row rather than creating a new one; see sale-service.ts's
// updateSaleOutcome(). campaignId is denormalized from Lead.campaignId at
// creation time — safe because Leads are campaign-scoped and never move
// between campaigns — so campaign-level aggregation never needs a join
// through Lead. won/lost cross-field consistency (saleValue required+
// positive & lostReason null for won; reverse for lost) is enforced in
// sale-schema.ts / sale-service.ts, not a DB constraint — matching this
// project's existing convention of enforcing such invariants at the
// application layer (Launch's idempotency key, FollowUp's allowed day
// values).
model Sale {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String     @unique @map("lead_id") @db.Uuid
  campaignId String     @map("campaign_id") @db.Uuid
  status     SaleStatus
  saleValue  Decimal?   @map("sale_value") @db.Decimal(12, 2)
  lostReason String?    @map("lost_reason")
  closedAt   DateTime   @map("closed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("sales")
}

// Which dataset(s) a campaign targets. Datasets are selected independently —
// this table never implies any merging between them.
model CampaignDataset {
  campaignId String @map("campaign_id") @db.Uuid
  datasetId  String @map("dataset_id") @db.Uuid

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dataset  Dataset  @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@id([campaignId, datasetId])
  @@map("campaign_datasets")
}

// Selected buildings for a campaign. datasetId is kept explicit alongside
// buildingId (even though it's derivable via Building.datasetId) so dataset
// origin is visible directly in this table — a guardrail against ever
// treating cross-dataset selections as one merged pool.
model CampaignBuilding {
  campaignId String @map("campaign_id") @db.Uuid
  datasetId  String @map("dataset_id") @db.Uuid
  buildingId String @map("building_id") @db.Uuid

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dataset  Dataset  @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@id([campaignId, buildingId])
  @@index([campaignId, datasetId])
  @@map("campaign_buildings")
}

// Generic audit trail. Phase 1 only ever writes actorType = human; the shape
// exists now so Phase 2/3 AI/system actions need no schema change later.
model ActivityLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  action     String
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid // references auth.users when actorType = human
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("activity_log")
}
